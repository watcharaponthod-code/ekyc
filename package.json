{
  "name": "ekyc-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@ekyc/react-native-ekyc --workspace=@ekyc/react-native-ekyc-local",
    "example": "npm run start --workspace=example",
    "local": "npm run start --workspace=local"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  }
}