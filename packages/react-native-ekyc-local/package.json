{
  "name": "@ekyc/react-native-ekyc-local",
  "version": "0.1.0",
  "description": "100% on-device liveness (turn / open mouth / move closer & farther via ML Kit) with a face-continuity check. No server, no model. The MobileFaceNet + rPPG edition ships as ./heavy.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4"
  },
  "peerDependencies": {
    "@ekyc/react-native-ekyc": "*",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-nitro-modules": ">=0.35.0",
    "react-native-svg": ">=15.0.0",
    "react-native-vision-camera": ">=5.0.0",
    "react-native-vision-camera-face-detector": ">=2.0.0",
    "expo-image-manipulator": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "sideEffects": false,
  "peerDependenciesMeta": {
    "expo-asset": {
      "optional": true
    },
    "react-native-fast-tflite": {
      "optional": true
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./heavy": "./src/heavy/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}